NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Sber internet acquiring / SberPay. These are supplied after merchant onboarding.
SBER_USERNAME=
SBER_PASSWORD=
SBER_RETURN_URL=https://re-project-arh.vercel.app/account
SBER_CALLBACK_URL=https://re-project-arh.vercel.app/api/payment/callback

# Optional: if you use Sber "Плати QR v3" through Sber API instead of e-commerce gateway.
SBER_API_CLIENT_ID=
SBER_API_CLIENT_SECRET=
SBER_QR_MEMBER_ID=
SBER_QR_TERMINAL_ID=
SBER_QR_API_URL=

# Manual payment by phone transfer (used automatically while SBER_USERNAME/SBER_PASSWORD are empty).
# The owner confirms each transfer in /admin -> Оплаты.
MANUAL_PAY_PHONE=+7 977 916-65-65
